# npm reads .npmrc from the current directory only — it does not walk up to the
# repo root. The `netlify` and `install-all` scripts install this package with
# `cd packages/<pkg> && npm install`, so the root .npmrc does not apply here and
# the @ericpitcock/epicenter-icons-* dependency resolves against npmjs.org and
# 404s. That is not hypothetical: it broke the Netlify build the first time this
# package declared an @ericpitcock dependency.
@ericpitcock:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${VITE_APP_GITHUB_TOKEN}

# Same reasoning as the root .npmrc: keep the release-age delay for third-party
# packages, never for our own — otherwise every build in the three days after a
# publish fails with ETARGET and looks like a broken release.
min-release-age-exclude[]=@ericpitcock/*
