{
  "name": "@ericpitcock/epicenter-icons-react",
  "version": "1.0.0",
  "description": "Epicenter Icons for React",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.jsx"
    },
    "./base.scss": "./base.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.jsx",
    "*.d.ts",
    "base.scss",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "react",
    "icons",
    "svg",
    "components",
    "epicenter",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericpitcock/epicenter-design-system.git"
  },
  "author": "Eric Pitcock",
  "license": "MIT"
}