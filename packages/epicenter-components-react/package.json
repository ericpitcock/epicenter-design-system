{
  "name": "@ericpitcock/epicenter-components-react",
  "version": "2.0.0-beta.4",
  "description": "Epicenter Design System - React Components",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.mjs"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericpitcock/epicenter-design-system.git"
  },
  "author": "Eric Pitcock",
  "license": "MIT",
  "dependencies": {
    "@ericpitcock/epicenter-icons-react": "^2.0.0-beta.4"
  },
  "peerDependencies": {
    "d3": "^7.9.0",
    "flatpickr": "^4.6.13",
    "framer-motion": "^12.29.2",
    "highcharts": "^12.6.0",
    "mapbox-gl": "^3.29.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^7.18.0",
    "shiki": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "d3": {
      "optional": true
    },
    "flatpickr": {
      "optional": true
    },
    "highcharts": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "d3": "^7.9.0",
    "flatpickr": "^4.6.13",
    "framer-motion": "^12.43.0",
    "highcharts": "^12.6.0",
    "mapbox-gl": "^3.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "shiki": "^2.5.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
