//npm.pkg.github.com/:_authToken=${VITE_APP_GITHUB_TOKEN}
@ericpitcock:registry=https://npm.pkg.github.com/

# min-release-age (set globally in ~/.npmrc, and on the deploy server) refuses
# anything published in the last few days. That is worth keeping for third-party
# dependencies, but it also blocks our own packages the moment we publish one —
# a deploy right after a release fails with ETARGET "no matching version with a
# date before <date>", which reads like a broken publish and is not one.
#
# Exempt only the first-party scope. Everything else keeps the delay.
min-release-age-exclude[]=@ericpitcock/*
